# Copy to .env before starting the local stack. Development defaults only —
# no real credentials belong here or in the repository.
VOICELOOP_ENV=dev

# Postgres
POSTGRES_DB=voiceloop
POSTGRES_USER=voiceloop
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_PORT=5432
VOICELOOP_PG_DSN=postgresql+psycopg2://voiceloop:dev-only-change-me@postgres:5432/voiceloop

# MinIO (S3-compatible object store)
MINIO_ROOT_USER=voiceloop_dev
MINIO_ROOT_PASSWORD=dev-only-change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=voiceloop-artifacts
AWS_ACCESS_KEY_ID=voiceloop_dev
AWS_SECRET_ACCESS_KEY=dev-only-change-me
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# MLflow
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000

# Environment prefix hints for typed settings (see voiceloop_common.settings).
# Each component reads only variables with its own prefix.
VOICELOOP_COMMON_LOG_LEVEL=INFO
VOICELOOP_INGEST_DATABASE_URL=postgresql+psycopg2://voiceloop:dev-only-change-me@localhost:5432/voiceloop
VOICELOOP_INGEST_S3_ENDPOINT=http://localhost:9000
VOICELOOP_INGEST_S3_BUCKET=voiceloop-artifacts
